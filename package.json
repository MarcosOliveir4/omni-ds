{
  "name": "omni-ds",
  "private": false,
  "version": "0.0.1",
  "description": "Omni Design System",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "style": "./dist/omni-ds.css",
  "exports": {
    ".": "./dist/omni-ds.css",
    "./omni-ds.css": "./dist/omni-ds.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "eslint": "eslint .",
    "prettier:check": "prettier . --check",
    "prettier:format": "prettier . --write",
    "test:browser": "vitest",
    "test:ci": "vitest run --browser.headless",
    "test:coverage": "vitest run --coverage --browser.headless",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/html": "^10.5.3",
    "@storybook/html-vite": "^10.5.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "chromatic": "^18.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.1.0",
    "prettier": "3.9.6",
    "sass": "^1.101.3",
    "storybook": "^10.5.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
